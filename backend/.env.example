# Connection string for the local Postgres started via `docker compose up -d`
# at the repo root (see docker-compose.yml).
DATABASE_URL="postgresql://tandem:tandem@localhost:5432/tandem?schema=public"

# Credentials for the one admin user that gets created automatically on first
# startup, when the `users` table is empty. Not used again after that.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Admin"

# Secret used to sign the session JWT issued after a successful login.
APP_JWT_SECRET="change-me"

# Comma-separated origin(s) allowed to call the API via CORS.
# Defaults to the frontend's local dev server (`pnpm --filter frontend dev`) if unset.
CORS_ORIGIN="http://localhost:5173"
