# Connection string for the local Postgres started via `docker compose up -d`
# at the repo root (see docker-compose.yml).
DATABASE_URL="postgresql://tandem:tandem@localhost:5432/tandem?schema=public"

# Shared password required to obtain a session token from POST /api/v1/auth/login.
# There are no user accounts in the MVP - this is the single app-wide password.
APP_PASSWORD="change-me"

# Secret used to sign the session JWT issued after a successful login.
APP_JWT_SECRET="change-me"
