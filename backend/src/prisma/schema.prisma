generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FormFieldType {
  text
  textarea
  number
  boolean
  select
  multi_select
  date
}

model FormTemplate {
  id             String              @id @db.Char(26)
  name           String
  description    String?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  templateFields FormTemplateField[]
  forms          Form[]

  @@map("form_templates")
}

model FormTemplateField {
  id             String        @id @db.Char(26)
  formTemplateId String        @map("form_template_id") @db.Char(26)
  formTemplate   FormTemplate  @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  label          String
  fieldType      FormFieldType @map("field_type")
  isRequired     Boolean       @default(false) @map("is_required")
  options        Json?
  orderIndex     Int           @map("order_index")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([formTemplateId])
  @@map("form_template_fields")
}

model Form {
  id             String        @id @db.Char(26)
  formTemplateId String?       @map("form_template_id") @db.Char(26)
  formTemplate   FormTemplate? @relation(fields: [formTemplateId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  fields         FormField[]
  formResponse   FormResponse?

  @@index([formTemplateId])
  @@map("forms")
}

model FormField {
  id         String        @id @db.Char(26)
  formId     String        @map("form_id") @db.Char(26)
  form       Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  label      String
  fieldType  FormFieldType @map("field_type")
  isRequired Boolean       @default(false) @map("is_required")
  options    Json?
  orderIndex Int           @map("order_index")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([formId])
  @@map("form_fields")
}

model FormResponse {
  id           String   @id @db.Char(26)
  formId       String   @unique @map("form_id") @db.Char(26)
  form         Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  responseData Json     @default("{}") @map("response_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("form_responses")
}

model Deliverable {
  id          String   @id @db.Char(26)
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("deliverables")
}
