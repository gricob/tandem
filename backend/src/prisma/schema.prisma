generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FormFieldType {
  text
  textarea
  number
  boolean
  select
  multi_select
  date
}

model FormTemplate {
  id             String              @id @db.Char(26)
  name           String
  description    String?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  templateFields FormTemplateField[]
  forms          Form[]

  @@map("form_templates")
}

model FormTemplateField {
  id             String        @id @db.Char(26)
  formTemplateId String        @map("form_template_id") @db.Char(26)
  formTemplate   FormTemplate  @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  label          String
  fieldType      FormFieldType @map("field_type")
  isRequired     Boolean       @default(false) @map("is_required")
  options        Json?
  orderIndex     Int           @map("order_index")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([formTemplateId])
  @@map("form_template_fields")
}

model Form {
  id                  String               @id @db.Char(26)
  formTemplateId      String?              @map("form_template_id") @db.Char(26)
  formTemplate        FormTemplate?        @relation(fields: [formTemplateId], references: [id], onDelete: SetNull)
  name                String
  description         String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  fields              FormField[]
  formResponse        FormResponse?
  userStory           UserStory?
  acceptanceCriterion AcceptanceCriterion?

  @@index([formTemplateId])
  @@map("forms")
}

model FormField {
  id         String        @id @db.Char(26)
  formId     String        @map("form_id") @db.Char(26)
  form       Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  label      String
  fieldType  FormFieldType @map("field_type")
  isRequired Boolean       @default(false) @map("is_required")
  options    Json?
  orderIndex Int           @map("order_index")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([formId])
  @@map("form_fields")
}

model FormResponse {
  id           String   @id @db.Char(26)
  formId       String   @unique @map("form_id") @db.Char(26)
  form         Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  responseData Json     @default("{}") @map("response_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("form_responses")
}

model Deliverable {
  id          String      @id @db.Char(26)
  name        String
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  userStories UserStory[]

  @@map("deliverables")
}

model UserStory {
  id                 String                @id @db.Char(26)
  form               Form                  @relation(fields: [id], references: [id], onDelete: Cascade)
  deliverableId      String                @map("deliverable_id") @db.Char(26)
  deliverable        Deliverable           @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  orderIndex         Int                   @map("order_index")
  acceptanceCriteria AcceptanceCriterion[]

  @@index([deliverableId])
  @@map("user_stories")
}

model AcceptanceCriterion {
  id          String    @id @db.Char(26)
  form        Form      @relation(fields: [id], references: [id], onDelete: Cascade)
  userStoryId String    @map("user_story_id") @db.Char(26)
  userStory   UserStory @relation(fields: [userStoryId], references: [id], onDelete: Cascade)
  orderIndex  Int       @map("order_index")

  @@index([userStoryId])
  @@map("acceptance_criteria")
}
