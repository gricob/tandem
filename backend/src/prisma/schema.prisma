generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FormFieldType {
  text
  textarea
  number
  boolean
  select
  multi_select
  date
}

model FormType {
  id          String      @id @db.Char(26)
  name        String
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  fields      FormField[]
  forms       Form[]

  @@map("form_types")
}

model FormField {
  id         String        @id @db.Char(26)
  formTypeId String        @map("form_type_id") @db.Char(26)
  formType   FormType      @relation(fields: [formTypeId], references: [id], onDelete: Cascade)
  label      String
  fieldType  FormFieldType @map("field_type")
  isRequired Boolean       @default(false) @map("is_required")
  options    Json?
  orderIndex Int           @map("order_index")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([formTypeId])
  @@map("form_fields")
}

model Form {
  id           String        @id @db.Char(26)
  formTypeId   String        @map("form_type_id") @db.Char(26)
  formType     FormType      @relation(fields: [formTypeId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  formResponse FormResponse?

  @@index([formTypeId])
  @@map("forms")
}

model FormResponse {
  id           String   @id @db.Char(26)
  formId       String   @unique @map("form_id") @db.Char(26)
  form         Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  responseData Json     @default("{}") @map("response_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("form_responses")
}
